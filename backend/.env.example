# LLM 配置 - 兼容 OpenAI API 格式
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3-max

# Embedding 模型配置 (用于 RAG)
EMBEDDING_MODEL=text-embedding-v4

# 服务端口
PORT=8002

# 安全配置
SANDBOX_ROOT=./

# Docker 沙箱（设为 true 启用容器隔离执行 terminal / python_repl）
SANDBOX_ENABLED=false
SANDBOX_IMAGE=mini-openclaw-sandbox
SANDBOX_CONTAINER_NAME=mini-openclaw-sandbox
SANDBOX_EXECUTOR_PORT=9999
